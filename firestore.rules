rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Blueprints (Validation Helpers)
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'username', 'photoURL', 'status', 'language', 'createdAt', 'lastSeen']) &&
        data.keys().hasOnly(['uid', 'displayName', 'username', 'photoURL', 'bio', 'status', 'language', 'createdAt', 'lastSeen']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 60 &&
        data.photoURL is string && data.photoURL.size() <= 1000 &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
        data.status is string && data.status.size() <= 20 && data.status in ['online', 'offline'] &&
        data.language is string && data.language.size() <= 10 && data.language in ['en', 'km'] &&
        data.createdAt is timestamp &&
        data.lastSeen is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 254 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLastMessageMap(lm) {
      return lm is map &&
        lm.keys().hasAll(['text', 'senderId', 'type', 'createdAt']) &&
        lm.keys().hasOnly(['text', 'senderId', 'type', 'createdAt']) &&
        lm.text is string && lm.text.size() <= 2000 &&
        lm.senderId is string && lm.senderId.size() >= 1 && lm.senderId.size() <= 128 && lm.senderId.matches('^[a-zA-Z0-9_\\-]+$') &&
        lm.type is string && lm.type.size() <= 20 && lm.type in ['text', 'image', 'file', 'voice'] &&
        lm.createdAt is timestamp;
    }

    function isValidChat(data) {
      return data.keys().hasAll(['type', 'name', 'photoURL', 'memberIds', 'adminIds', 'createdBy', 'createdAt', 'updatedAt', 'isBroadcastOnly']) &&
        data.keys().hasOnly(['type', 'name', 'photoURL', 'memberIds', 'adminIds', 'createdBy', 'createdAt', 'updatedAt', 'isBroadcastOnly', 'lastMessage']) &&
        data.type is string && data.type.size() <= 20 && data.type in ['private', 'group', 'channel'] &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.photoURL is string && data.photoURL.size() <= 1000 &&
        data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 50 &&
        data.memberIds[0] is string && data.memberIds[0].size() <= 128 &&
        data.adminIds is list && data.adminIds.size() >= 1 && data.adminIds.size() <= 20 &&
        data.adminIds[0] is string && data.adminIds[0].size() <= 128 &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 && data.createdBy.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.isBroadcastOnly is bool &&
        (!('lastMessage' in data) || isValidLastMessageMap(data.lastMessage));
    }

    function isValidMessage(data, chatId) {
      return data.keys().hasAll(['chatId', 'senderId', 'memberIds', 'type', 'text', 'mediaUrl', 'mediaName', 'mediaSize', 'voiceDurationSec', 'createdAt', 'updatedAt', 'readBy', 'deleted']) &&
        data.keys().hasOnly(['chatId', 'senderId', 'memberIds', 'type', 'text', 'mediaUrl', 'mediaName', 'mediaSize', 'voiceDurationSec', 'createdAt', 'updatedAt', 'readBy', 'deleted']) &&
        data.chatId is string && data.chatId.size() >= 1 && data.chatId.size() <= 128 && data.chatId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.chatId == chatId &&
        data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 && data.senderId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 50 &&
        data.memberIds[0] is string && data.memberIds[0].size() <= 128 &&
        data.type is string && data.type.size() <= 20 && data.type in ['text', 'image', 'file', 'voice'] &&
        data.text is string && data.text.size() <= 2000 &&
        data.mediaUrl is string && data.mediaUrl.size() <= 1500 &&
        data.mediaName is string && data.mediaName.size() <= 255 &&
        data.mediaSize is int && data.mediaSize >= 0 && data.mediaSize <= 52428800 &&
        data.voiceDurationSec is int && data.voiceDurationSec >= 0 && data.voiceDurationSec <= 3600 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.readBy is list && data.readBy.size() >= 1 && data.readBy.size() <= 50 &&
        data.readBy[0] is string && data.readBy[0].size() <= 128 &&
        data.deleted is bool;
    }

    function isValidTyping(data, chatId, typingUid) {
      return data.keys().hasAll(['uid', 'chatId', 'memberIds', 'isTyping', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'chatId', 'memberIds', 'isTyping', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == typingUid &&
        data.uid == request.auth.uid &&
        data.chatId is string && data.chatId.size() >= 1 && data.chatId.size() <= 128 && data.chatId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.chatId == chatId &&
        data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 50 &&
        data.memberIds[0] is string && data.memberIds[0].size() <= 128 &&
        data.isTyping is bool &&
        data.updatedAt is timestamp;
    }

    // Master Gate Relational Helpers
    function isChatMember(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
    }

    function isAllowedToPostInChat(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds &&
        (
          get(/databases/$(database)/documents/chats/$(chatId)).data.isBroadcastOnly == false ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.adminIds
        );
    }

    // Public User Profiles (Non-PII)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && existing().status in ['online', 'offline'];
      allow create: if isSignedIn() &&
        isVerified() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().lastSeen == request.time;
      allow update: if isSignedIn() &&
        isVerified() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().lastSeen == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'username', 'photoURL', 'bio', 'status', 'language', 'lastSeen']);
      allow delete: if false;

      // Isolated User PII Subcollection
      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(docId) && request.auth.uid == userId;
        allow list: if false;
        allow create: if isSignedIn() &&
          isVerified() &&
          isValidId(userId) &&
          isValidId(docId) &&
          request.auth.uid == userId &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isSignedIn() &&
          isVerified() &&
          isValidId(userId) &&
          isValidId(docId) &&
          request.auth.uid == userId &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if false;
      }
    }

    // Chats Collection
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId) && request.auth.uid in existing().memberIds;
      allow list: if isSignedIn() && request.auth.uid in existing().memberIds;
      allow create: if isSignedIn() &&
        isVerified() &&
        isValidId(chatId) &&
        isValidChat(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        request.auth.uid in incoming().memberIds &&
        request.auth.uid in incoming().adminIds &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isSignedIn() &&
        isVerified() &&
        isValidId(chatId) &&
        isValidChat(incoming()) &&
        request.auth.uid in existing().memberIds &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().type == existing().type &&
        incoming().isBroadcastOnly == existing().isBroadcastOnly &&
        incoming().memberIds == existing().memberIds &&
        incoming().adminIds == existing().adminIds &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Update lastMessage when sending a message
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'updatedAt']) &&
            'lastMessage' in incoming() &&
            incoming().lastMessage.senderId == request.auth.uid &&
            incoming().lastMessage.createdAt == request.time &&
            (!existing().isBroadcastOnly || request.auth.uid in existing().adminIds)
          ) ||
          // Action 2: Admin updates chat name or photoURL
          (
            request.auth.uid in existing().adminIds &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoURL', 'updatedAt'])
          )
        );
      allow delete: if false;

      // Messages Subcollection
      match /messages/{messageId} {
        allow get: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(messageId) &&
          request.auth.uid in existing().memberIds &&
          isChatMember(chatId);
        allow list: if isSignedIn() &&
          request.auth.uid in existing().memberIds;
        allow create: if isSignedIn() &&
          isVerified() &&
          isValidId(chatId) &&
          isValidId(messageId) &&
          isValidMessage(incoming(), chatId) &&
          incoming().senderId == request.auth.uid &&
          request.auth.uid in incoming().memberIds &&
          request.auth.uid in incoming().readBy &&
          incoming().deleted == false &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isAllowedToPostInChat(chatId);
        allow update: if isSignedIn() &&
          isVerified() &&
          isValidId(chatId) &&
          isValidId(messageId) &&
          isValidMessage(incoming(), chatId) &&
          existing().deleted == false &&
          incoming().chatId == existing().chatId &&
          incoming().senderId == existing().senderId &&
          incoming().memberIds == existing().memberIds &&
          incoming().type == existing().type &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            // Action 1: Member marks message as read
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['readBy', 'updatedAt']) &&
              request.auth.uid in incoming().readBy &&
              incoming().deleted == false
            ) ||
            // Action 2: Sender soft-deletes message (Terminal State Transition)
            (
              existing().senderId == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['deleted', 'text', 'mediaUrl', 'updatedAt']) &&
              incoming().deleted == true &&
              incoming().text == '' &&
              incoming().mediaUrl == ''
            )
          ) &&
          isChatMember(chatId);
        allow delete: if false;
      }

      // Typing Indicators Subcollection
      match /typing/{typingUid} {
        allow get: if isSignedIn() &&
          isValidId(chatId) &&
          isValidId(typingUid) &&
          request.auth.uid in existing().memberIds &&
          isChatMember(chatId);
        allow list: if isSignedIn() &&
          request.auth.uid in existing().memberIds;
        allow create: if isSignedIn() &&
          isVerified() &&
          isValidId(chatId) &&
          isValidId(typingUid) &&
          typingUid == request.auth.uid &&
          isValidTyping(incoming(), chatId, typingUid) &&
          request.auth.uid in incoming().memberIds &&
          incoming().updatedAt == request.time &&
          isChatMember(chatId);
        allow update: if isSignedIn() &&
          isVerified() &&
          isValidId(chatId) &&
          isValidId(typingUid) &&
          typingUid == request.auth.uid &&
          isValidTyping(incoming(), chatId, typingUid) &&
          incoming().uid == existing().uid &&
          incoming().chatId == existing().chatId &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isTyping', 'memberIds', 'updatedAt']) &&
          isChatMember(chatId);
        allow delete: if false;
      }
    }
  }
}
